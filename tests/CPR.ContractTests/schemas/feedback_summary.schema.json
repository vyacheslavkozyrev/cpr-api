{
    "$id": "https://example.com/schemas/feedback_summary.schema.json",
    "type": "object",
    "required": [
        "statistics",
        "recent_feedback",
        "rating_trend"
    ],
    "properties": {
        "statistics": {
            "type": "object",
            "required": [
                "total_received",
                "pending_requests",
                "average_rating",
                "rating_distribution"
            ],
            "properties": {
                "total_received": {
                    "type": "integer",
                    "minimum": 0
                },
                "pending_requests": {
                    "type": "integer",
                    "minimum": 0
                },
                "average_rating": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5
                },
                "rating_distribution": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                    }
                }
            },
            "additionalProperties": false
        },
        "recent_feedback": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "from_employee_id",
                    "from_employee_name",
                    "goal_title",
                    "created_at"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "from_employee_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "from_employee_name": {
                        "type": "string"
                    },
                    "goal_title": {
                        "type": "string"
                    },
                    "rating": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1,
                        "maximum": 5
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "additionalProperties": false
            }
        },
        "rating_trend": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "period",
                    "average_rating",
                    "count"
                ],
                "properties": {
                    "period": {
                        "type": "string"
                    },
                    "average_rating": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                    },
                    "count": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}