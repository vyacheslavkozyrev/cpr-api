{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
        "type": "object",
        "required": [
            "id",
            "title",
            "career_path_id"
        ],
        "properties": {
            "id": {
                "type": "string",
                "format": "uuid"
            },
            "title": {
                "type": "string"
            },
            "description": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "career_path_id": {
                "type": "string",
                "format": "uuid"
            }
        },
        "additionalProperties": false
    }
}