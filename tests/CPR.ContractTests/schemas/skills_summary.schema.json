{
    "$id": "https://example.com/schemas/skills_summary.schema.json",
    "type": "object",
    "required": [
        "statistics",
        "skill_categories",
        "recent_assessments"
    ],
    "properties": {
        "statistics": {
            "type": "object",
            "required": [
                "total_skills",
                "assessed_skills",
                "assessment_progress",
                "average_level",
                "skill_gaps"
            ],
            "properties": {
                "total_skills": {
                    "type": "integer",
                    "minimum": 0
                },
                "assessed_skills": {
                    "type": "integer",
                    "minimum": 0
                },
                "assessment_progress": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                },
                "average_level": {
                    "type": "number",
                    "minimum": 0
                },
                "skill_gaps": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "skill_categories": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "category_id",
                    "category_name",
                    "total_skills",
                    "assessed_skills",
                    "average_level"
                ],
                "properties": {
                    "category_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "category_name": {
                        "type": "string"
                    },
                    "total_skills": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "assessed_skills": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "average_level": {
                        "type": "number",
                        "minimum": 0
                    }
                },
                "additionalProperties": false
            }
        },
        "recent_assessments": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "skill_id",
                    "skill_name",
                    "level",
                    "assessed_at"
                ],
                "properties": {
                    "skill_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "skill_name": {
                        "type": "string"
                    },
                    "level": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                    },
                    "assessed_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}