{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/position_skills.schema.json",
    "type": "array",
    "items": {
        "type": "object",
        "required": [
            "id",
            "position_id",
            "skill_id",
            "skill_title",
            "skill_level_id",
            "skill_level_title",
            "created_at"
        ],
        "properties": {
            "id": {
                "type": "string",
                "format": "uuid"
            },
            "position_id": {
                "type": "string",
                "format": "uuid"
            },
            "skill_id": {
                "type": "string",
                "format": "uuid"
            },
            "skill_title": {
                "type": "string"
            },
            "skill_level_id": {
                "type": "string",
                "format": "uuid"
            },
            "skill_level_title": {
                "type": "string"
            },
            "created_at": {
                "type": "string",
                "format": "date-time"
            }
        },
        "additionalProperties": false
    }
}