{
    "$id": "https://example.com/schemas/goals_summary.schema.json",
    "type": "object",
    "required": [
        "statistics",
        "recent_goals",
        "progress_trend"
    ],
    "properties": {
        "statistics": {
            "type": "object",
            "required": [
                "total",
                "active",
                "completed",
                "overdue",
                "completion_rate",
                "average_progress"
            ],
            "properties": {
                "total": {
                    "type": "integer",
                    "minimum": 0
                },
                "active": {
                    "type": "integer",
                    "minimum": 0
                },
                "completed": {
                    "type": "integer",
                    "minimum": 0
                },
                "overdue": {
                    "type": "integer",
                    "minimum": 0
                },
                "completion_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                },
                "average_progress": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                }
            },
            "additionalProperties": false
        },
        "recent_goals": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "title",
                    "status",
                    "progress",
                    "is_overdue"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "progress": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "deadline": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "is_overdue": {
                        "type": "boolean"
                    }
                },
                "additionalProperties": false
            }
        },
        "progress_trend": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "period",
                    "completed",
                    "created"
                ],
                "properties": {
                    "period": {
                        "type": "string"
                    },
                    "completed": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "created": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}